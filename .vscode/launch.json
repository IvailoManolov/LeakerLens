{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run LeakLens (Sandbox)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/.sandbox",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "build"
    }
  ]
}
